{
  "name": "relaychat",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:desktop": "npm --workspace apps/desktop run tauri",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "build:web": "npm --workspace apps/web run build",
    "build:desktop": "npm --workspace apps/desktop run tauri:build",
    "lint": "npm --workspaces run lint",
    "typecheck": "npm --workspaces run typecheck",
    "build:packages": "npm --workspace packages/protocol run build && npm --workspace packages/client-sdk run build && npm --workspace packages/ui run build"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.46.2"
  }
}
